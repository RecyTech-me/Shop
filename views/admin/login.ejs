<%- include("../partials/head", { title }) %>
<%- include("../partials/header") %>
<%- include("../partials/flash") %>

<main id="main-content" tabindex="-1" class="shell section-stack admin-page">
    <section class="auth-card">
        <p class="eyebrow"><%= typeof documentAccess !== "undefined" && documentAccess ? "Documents de l’association" : "Administration" %></p>
        <h1>Connexion</h1>
        <p><%= typeof documentAccess !== "undefined" && documentAccess ? "Connectez-vous avec votre compte du shop pour consulter les documents du comité et des assemblées générales." : "Connectez-vous pour gérer la boutique." %></p>
        <form action="/admin/login" method="post" class="form-stack">
            <%- include("../partials/csrf-field") %>
            <label>Nom d'utilisateur
                <input type="text" name="username" required>
            </label>
            <label>Mot de passe
                <input type="password" name="password" required>
            </label>
            <button type="submit" class="button button-block">Se connecter</button>
        </form>
    </section>
</main>

<%- include("../partials/footer") %>
